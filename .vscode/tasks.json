{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: watch",
      "type": "shell",
      "command": "pnpm run watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[esbuild\\]",
          "endsPattern": "^\\[esbuild\\] (watching for changes\\.\\.\\.|extension build complete\\.)"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "pnpm: build",
      "type": "shell",
      "command": "pnpm run build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "pnpm: test",
      "type": "shell",
      "command": "pnpm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "pnpm: check",
      "type": "shell",
      "command": "pnpm run check",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
